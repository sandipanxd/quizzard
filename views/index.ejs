<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quiz Session - Quizzard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    body {
      font-family: 'Outfit', sans-serif;
    }

    .glass-card {
      background: rgba(28, 25, 23, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
      animation: fadeIn 0.3s ease-out forwards;
    }
  </style>
</head>

<body
  class="bg-gradient-to-br from-[#0a0a0a] via-[#171513] to-[#0d0c0a] text-stone-100 min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden">
  <!-- Decorative background glow blobs -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl -z-10"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-orange-600/10 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-3xl w-full">
    <!-- Header info -->
    <div class="flex flex-col sm:flex-row justify-between items-center mb-6 gap-4 px-2">
      <div class="flex items-center gap-3">
        <span class="text-3xl">📖</span>
        <div>
          <h2 class="text-xl font-bold">Quizzard Session</h2>
          <p class="text-xs text-stone-400">
            Welcome back,
            <span id="user-name-display" class="text-amber-300 font-semibold"></span>
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="bg-stone-900/60 border border-stone-850 rounded-lg px-4 py-2 text-right">
          <p class="text-xs text-stone-500 uppercase tracking-wider">Active Topic</p>
          <p id="section-name-display" class="text-sm font-semibold text-amber-300"></p>
        </div>

        <button id="sound-toggle" type="button"
          class="bg-stone-900/60 border border-stone-850 rounded-lg px-3 py-2 hover:border-amber-500/40 transition">
          🔊
        </button>
      </div>
    </div>

    <!-- Main quiz card -->
    <div class="glass-card rounded-2xl shadow-2xl p-6 sm:p-8">

      <!-- Loading state -->
      <div id="quiz-loading" class="flex flex-col items-center justify-center py-20 space-y-4">
        <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-amber-400"></div>
        <p class="text-stone-400 text-sm">Loading quiz questions...</p>
      </div>

      <!-- Quiz form -->
      <form id="quiz-form" class="hidden space-y-6">
        <!-- Progress and Timer Header -->
        <div class="flex flex-col sm:flex-row justify-between items-center pb-4 border-b border-stone-800/80 gap-4">
          <div class="w-full sm:w-2/3">
            <div class="flex justify-between text-xs text-stone-400 mb-1">
              <span id="question-progress-text" class="font-medium">Question 1 of 5</span>
              <span id="quiz-percent-text" class="font-semibold text-amber-400">20% Complete</span>
            </div>
            <div class="w-full bg-stone-950/60 rounded-full h-2 overflow-hidden border border-stone-850">
              <div id="quiz-progress-bar" class="bg-gradient-to-r from-amber-500 to-orange-500 h-2 transition-all duration-300" style="width: 20%"></div>
            </div>
          </div>
          <div class="flex items-center gap-3 bg-stone-950/40 border border-stone-850 rounded-lg px-4 py-2">
            <span class="text-stone-400 text-sm">⏱️ Timer:</span>
            <span id="question-timer" class="text-xl font-bold font-mono text-amber-400">20s</span>
          </div>
        </div>

        <!-- Question Container -->
        <div id="quiz-container" class="space-y-6"></div>

        <!-- Explanation card (revealed after option selection or timeout) -->
        <div id="explanation-container" class="hidden p-5 bg-amber-950/20 border border-amber-500/30 rounded-xl space-y-2 animate-fadeIn">
          <div class="flex items-center gap-2 text-amber-400 text-sm font-semibold">
            <span>💡</span> Concept Explanation
          </div>
          <p id="explanation-text" class="text-sm text-amber-200/90 leading-relaxed"></p>
        </div>

        <!-- Navigation Buttons -->
        <div class="pt-4 border-t border-stone-850 flex flex-col sm:flex-row gap-4 justify-between items-center">
          <p id="helper-status-text" class="text-xs text-stone-500">Select an option to check your answer.</p>
          <button id="next-btn" type="button" class="hidden w-full sm:w-auto bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white font-semibold px-8 py-3 rounded-lg shadow-lg active:scale-[0.98] transition duration-300 flex items-center justify-center gap-2">
            <span>Next Question</span> ➡️
          </button>
          <button id="submit-btn" type="button" class="hidden w-full sm:w-auto bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-semibold px-8 py-3 rounded-lg shadow-lg active:scale-[0.98] transition duration-300 flex items-center justify-center gap-2">
            <span>Submit Quiz</span> 🏆
          </button>
        </div>
      </form>
    </div>

    <script>
      let audioCtx;
      let quizQuestions = [];
      let currentQuestionIndex = 0;
      let userAnswers = {};
      let timerInterval = null;
      const QUESTION_TIME_LIMIT = 20; // seconds
      let timeLeft = QUESTION_TIME_LIMIT;
      let soundEnabled = localStorage.getItem('soundEnabled') !== 'false';

      function playClickSound() {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }

        if (audioCtx.state === "suspended") {
          audioCtx.resume();
        }

        const oscillator = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();

        oscillator.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        oscillator.type = 'sine';
        oscillator.frequency.value = 700;

        gainNode.gain.value = 0.05;

        oscillator.start();
        oscillator.stop(audioCtx.currentTime + 0.08);
      }

      async function loadSectionName(sectionId) {
        const response = await fetch(`/api/quiz/sections/${sectionId}`);
        const section = await response.json();
        document.getElementById('section-name-display').textContent = section.name;
      }

      async function loadQuestions(sectionId, difficulty) {
        try {
          const response = await fetch(`/api/quiz/questions/${sectionId}/${difficulty}`);
          quizQuestions = await response.json();

          const loadingElem = document.getElementById('quiz-loading');
          const quizForm = document.getElementById('quiz-form');

          if (quizQuestions.length === 0) {
            loadingElem.innerHTML = `
              <p class="text-amber-400 text-sm font-semibold mb-2">No questions found for this category and difficulty.</p>
              <a href="/" class="text-xs text-stone-400 hover:text-white underline">Go back to main menu</a>
            `;
            return;
          }

          // Initialize game state
          currentQuestionIndex = 0;
          userAnswers = {};

          loadingElem.classList.add('hidden');
          quizForm.classList.remove('hidden');

          renderQuestion(currentQuestionIndex);
        } catch (err) {
          console.error("Error loading questions:", err);
          const loadingElem = document.getElementById('quiz-loading');
          loadingElem.innerHTML = `
            <p class="text-red-400 text-sm font-semibold mb-2">Failed to load quiz questions.</p>
            <a href="/" class="text-xs text-stone-400 hover:text-white underline">Go back to main menu</a>
          `;
        }
      }

      function renderQuestion(index) {
        if (index < 0 || index >= quizQuestions.length) return;
        
        const question = quizQuestions[index];
        const quizContainer = document.getElementById('quiz-container');
        
        // Update Progress Bar
        const progressPercent = Math.round(((index + 1) / quizQuestions.length) * 100);
        document.getElementById('question-progress-text').textContent = `Question ${index + 1} of ${quizQuestions.length}`;
        document.getElementById('quiz-percent-text').textContent = `${progressPercent}% Complete`;
        document.getElementById('quiz-progress-bar').style.width = `${progressPercent}%`;

        // Render question HTML
        quizContainer.innerHTML = `
          <div class="p-6 border border-stone-850 rounded-xl bg-stone-900/30 space-y-4 animate-fadeIn">
            <div class="flex items-start gap-3">
              <span class="bg-amber-500/20 text-amber-300 font-bold text-xs rounded-full px-2.5 py-1 mt-0.5">${index + 1}</span>
              <p class="text-lg font-medium text-stone-100">${question.question}</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-4 ml-8" id="options-group">
              <!-- Option 1 -->
              <label class="option-card relative cursor-pointer block" data-option="1">
                <div class="option-label p-3.5 border border-stone-800 bg-stone-950/40 hover:border-stone-700 rounded-lg text-sm text-stone-400 hover:text-stone-200 transition duration-200 flex items-center justify-between">
                  <span>${question.option1}</span>
                  <span class="option-feedback hidden text-base"></span>
                </div>
              </label>

              <!-- Option 2 -->
              <label class="option-card relative cursor-pointer block" data-option="2">
                <div class="option-label p-3.5 border border-stone-800 bg-stone-950/40 hover:border-stone-700 rounded-lg text-sm text-stone-400 hover:text-stone-200 transition duration-200 flex items-center justify-between">
                  <span>${question.option2}</span>
                  <span class="option-feedback hidden text-base"></span>
                </div>
              </label>

              <!-- Option 3 -->
              <label class="option-card relative cursor-pointer block" data-option="3">
                <div class="option-label p-3.5 border border-stone-800 bg-stone-950/40 hover:border-stone-700 rounded-lg text-sm text-stone-400 hover:text-stone-200 transition duration-200 flex items-center justify-between">
                  <span>${question.option3}</span>
                  <span class="option-feedback hidden text-base"></span>
                </div>
              </label>

              <!-- Option 4 -->
              <label class="option-card relative cursor-pointer block" data-option="4">
                <div class="option-label p-3.5 border border-stone-800 bg-stone-950/40 hover:border-stone-700 rounded-lg text-sm text-stone-400 hover:text-stone-200 transition duration-200 flex items-center justify-between">
                  <span>${question.option4}</span>
                  <span class="option-feedback hidden text-base"></span>
                </div>
              </label>
            </div>
          </div>
        `;

        // Hide Explanation and Next/Submit buttons initially
        document.getElementById('explanation-container').classList.add('hidden');
        document.getElementById('next-btn').classList.add('hidden');
        document.getElementById('submit-btn').classList.add('hidden');
        document.getElementById('helper-status-text').textContent = "Select an option to check your answer.";
        document.getElementById('helper-status-text').className = "text-xs text-stone-500";

        // Bind click events to options
        const optionCards = quizContainer.querySelectorAll('.option-card');
        optionCards.forEach(card => {
          card.addEventListener('click', () => {
            const selectedOption = parseInt(card.getAttribute('data-option'), 10);
            handleAnswerSelection(selectedOption);
          });
        });

        // Start Countdown Timer
        startTimer();
      }

      function startTimer() {
        clearInterval(timerInterval);
        
        timeLeft = QUESTION_TIME_LIMIT;
        const timerDisplay = document.getElementById('question-timer');
        timerDisplay.textContent = `${timeLeft}s`;
        timerDisplay.className = "text-xl font-bold font-mono text-amber-400";

        timerInterval = setInterval(() => {
          timeLeft--;
          timerDisplay.textContent = `${timeLeft}s`;
          
          if (timeLeft <= 5) {
            timerDisplay.className = "text-xl font-bold font-mono text-red-500 animate-pulse";
          }
          
          if (timeLeft <= 0) {
            clearInterval(timerInterval);
            handleTimeout();
          }
        }, 1000);
      }

      function handleTimeout() {
        const question = quizQuestions[currentQuestionIndex];
        const questionKey = `question-${question.id}`;
        
        userAnswers[questionKey] = 0;
        
        highlightOptions(0, question.correct_option);
        revealExplanation(question.explanation);
        
        const helperText = document.getElementById('helper-status-text');
        helperText.textContent = "Time's up!";
        helperText.className = "text-xs text-red-400 font-semibold animate-pulse";
        
        showNavButtons();
      }

      function handleAnswerSelection(selectedOption) {
        const question = quizQuestions[currentQuestionIndex];
        const questionKey = `question-${question.id}`;
        
        if (userAnswers[questionKey] !== undefined) return;
        
        clearInterval(timerInterval);
        userAnswers[questionKey] = selectedOption;
        
        if (soundEnabled) {
          playClickSound();
        }
        
        highlightOptions(selectedOption, question.correct_option);
        revealExplanation(question.explanation);
        showNavButtons();
      }

      function highlightOptions(selectedOption, correctOption) {
        const optionCards = document.querySelectorAll('.option-card');
        
        optionCards.forEach(card => {
          const optionNum = parseInt(card.getAttribute('data-option'), 10);
          const optionLabel = card.querySelector('.option-label');
          const feedbackSpan = card.querySelector('.option-feedback');
          
          optionLabel.classList.remove('hover:border-stone-700', 'hover:text-stone-200');
          optionLabel.classList.add('cursor-default');
          card.style.pointerEvents = 'none';

          if (optionNum === correctOption) {
            optionLabel.classList.remove('border-stone-800', 'bg-stone-950/40', 'text-stone-400');
            optionLabel.classList.add('border-emerald-500/70', 'bg-emerald-950/20', 'text-emerald-300');
            feedbackSpan.textContent = "✅";
            feedbackSpan.classList.remove('hidden');
          } else if (optionNum === selectedOption) {
            optionLabel.classList.remove('border-stone-800', 'bg-stone-950/40', 'text-stone-400');
            optionLabel.classList.add('border-red-500/70', 'bg-red-950/20', 'text-red-300');
            feedbackSpan.textContent = "❌";
            feedbackSpan.classList.remove('hidden');
          } else {
            optionLabel.classList.add('opacity-40');
          }
        });
      }

      function revealExplanation(explanation) {
        const explanationContainer = document.getElementById('explanation-container');
        const explanationText = document.getElementById('explanation-text');
        
        explanationText.textContent = explanation || "No explanation available for this question.";
        explanationContainer.classList.remove('hidden');
      }

      function showNavButtons() {
        const isLastQuestion = currentQuestionIndex === quizQuestions.length - 1;
        const helperText = document.getElementById('helper-status-text');
        
        if (isLastQuestion) {
          document.getElementById('submit-btn').classList.remove('hidden');
          if (timeLeft > 0) {
            helperText.textContent = "Ready to submit the quiz!";
            helperText.className = "text-xs text-emerald-400 font-semibold";
          }
        } else {
          document.getElementById('next-btn').classList.remove('hidden');
          if (timeLeft > 0) {
            helperText.textContent = "Proceed to the next question.";
            helperText.className = "text-xs text-amber-400 font-semibold";
          }
        }
      }

      document.getElementById('next-btn').addEventListener('click', () => {
        currentQuestionIndex++;
        renderQuestion(currentQuestionIndex);
      });

      async function submitQuiz() {
        const submitBtn = document.getElementById('submit-btn');
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span class="animate-pulse">Submitting...</span>`;

        try {
          const response = await fetch('/api/quiz/submit', {
            method: 'POST',
            body: JSON.stringify(userAnswers),
            headers: { 'Content-Type': 'application/json' }
          });

          const result = await response.json();
          const userName = window.localStorage.getItem('userName');
          const sectionId = window.localStorage.getItem('sectionId');

          await fetch('/api/quiz/save-result', {
            method: 'POST',
            body: JSON.stringify({ userName, sectionId, result }),
            headers: { 'Content-Type': 'application/json' }
          });

          window.localStorage.setItem('userAnswers', JSON.stringify(userAnswers));
          window.location.href = `/result?score=${result.score}&total=${result.total}&sectionId=${sectionId}`;
        } catch (err) {
          console.error("Error submitting quiz:", err);
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<span>Submit Quiz</span> 🏆`;
          alert("An error occurred while submitting. Please try again.");
        }
      }

      document.getElementById('submit-btn').addEventListener('click', submitQuiz);

      // Block form element default submits
      document.getElementById('quiz-form').addEventListener('submit', function (event) {
        event.preventDefault();
      });

      document.addEventListener('DOMContentLoaded', () => {
        const soundToggle = document.getElementById('sound-toggle');

        soundEnabled = localStorage.getItem('soundEnabled') !== 'false';
        soundToggle.textContent = soundEnabled ? '🔊' : '🔇';

        soundToggle.addEventListener('click', () => {
          soundEnabled = !soundEnabled;
          localStorage.setItem('soundEnabled', soundEnabled);
          soundToggle.textContent = soundEnabled ? '🔊' : '🔇';
        });

        const userName = window.localStorage.getItem('userName');
        const sectionId = window.localStorage.getItem('sectionId');
        const difficulty = window.localStorage.getItem('difficulty');

        if (!userName || !sectionId || !difficulty) {
          window.location.href = '/';
          return;
        }

        document.getElementById('user-name-display').textContent = userName;
        loadSectionName(sectionId);
        loadQuestions(sectionId, difficulty);
      });
    </script>
</body>

</html>
